# Ephemeral working files — nothing generated is ever tracked.
# input/    source material dropped in by the user; consumed inputs are
#           auto-moved to input/archive/<batch>/ by `./run.sh gen`
# outbox/   generated deck batches (deleted after Anki import)
# sample_deck.txt  written by `./run.sh sample`
input/
outbox/
sample_deck.txt
__pycache__/
.memory-updates

# Secrets
.env
